# Copy to .env and fill in. Never commit .env.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if auto-detect fails
MT5_PATH=
# Hours the broker server clock is ahead of UTC (verify on your broker)
MT5_SERVER_UTC_OFFSET=0
# Appended to every symbol, e.g. "m" -> XAUUSDm. Leave empty for none.
BROKER_SYMBOL_SUFFIX=m
LOG_LEVEL=INFO
# Phase 5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Phase 4: execution safety (everything below is OFF / safest by default) ----
# Which clock 22:30 (no new trades) and 23:00 (flatten) use. Default UTC. Examples: Africa/Kampala, America/New_York
STRATEGY_TIMEZONE=UTC
# Live orders need BOTH of these. Leave blank to stay in dry-run (order_check only, nothing is sent).
SMC_LIVE_EXECUTION=
SMC_LIVE_CONFIRM=
# Even with live enabled, REAL accounts are refused unless this is true. Validate on a DEMO account first.
SMC_ALLOW_REAL_ACCOUNT=

# ---- Phase 5: economic calendar + Telegram -----------------------------------------
# Provider: "faireconomy" (default, community ForexFactory JSON feed, no actual values) or "file".
CALENDAR_PROVIDER=faireconomy
CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# For provider=file: path to your calendar JSON. Optional overlay with actual values for ANY provider:
CALENDAR_FILE=
CALENDAR_ACTUALS_FILE=
# Telegram: create a bot with @BotFather, send it a message, then put the token and your chat id HERE (never in chat).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
